# Local real OpenRouter run. Copy to .env and replace only the key placeholder.
OPENROUTER_API_KEY=PUT_YOUR_KEY_HERE
OPENROUTER_SUBSCRIBER_API_KEY=
UW_OR_MODEL_ROUTINE=deepseek/deepseek-v4-flash-0731
UW_OR_MODEL_STAKES=deepseek/deepseek-v4-flash-0731
UW_OR_MODEL_REFLECT=deepseek/deepseek-v4-flash-0731
UW_OR_MODEL_PATRON_STAKES=

# Server/runtime
PORT=4000
UW_BRAIN=openrouter
UW_STORE=none
UW_MS_PER_SIM_MINUTE=1000
UW_CITIZENS=2
UW_SEED=7
UW_TOWN_ID=local-openrouter
UW_TOWN_NAME=The local island
UW_DAILY_CEILING_USD=5
UW_PUBLIC_URL=http://localhost:3000
UW_REAL_WORLD=43.17,16.44,Europe/Zagreb
UW_HARBORS=
UW_BOAT_SECRET=
UW_OPS_TOKEN=

# Optional provider/runtime integrations (leave empty for this smoke run)
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000
UW_DEV_OWNER=1
NEXT_PUBLIC_DEV_OWNER=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_RESIDENT=
STRIPE_PRICE_PATRON=
GEMINI_API_KEY=
RECRAFT_API_KEY=
RESEND_API_KEY=
MAIL_FROM=Unwatched <noreply@localhost>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
UW_AUDIT_OPENROUTER_API_KEY=
